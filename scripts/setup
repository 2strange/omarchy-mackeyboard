#!/usr/bin/bash
# One-time setup. Run as your normal user; it asks for sudo once.
#
#   1. Installs the root-owned helper to /usr/local/libexec/omarchy-mac-fnmode
#      and a sudoers rule that lets your user run exactly "helper 1" and
#      "helper 2" without a password.
#   2. Switches hid_apple to fnmode=1 (printed keys without Fn) and persists
#      it in /etc/modprobe.d/hid_apple.conf.
#   3. Adds one marked block to ~/.config/hypr/bindings.lua that loads the
#      plugin's function-row bindings and layout switch (skipped if the menu
#      already added it), then reloads Hyprland.
#
# Privilege boundary: root never opens a file under the plugin checkout. The
# privileged script (scripts/setup-root) is read into this process and passed
# to root as a string, and the helper's bytes are streamed to root on stdin.
# Root verifies those bytes against the SHA-256 pinned inside setup-root
# before installing anything, so a swap of either file after authorization
# cannot change what root installs.
set -euo pipefail
export PATH=/usr/bin:/usr/sbin

plugin_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
plugin_id=io.github.2strange.mackeyboard
parameter=/sys/module/hid_apple/parameters/fnmode
bindings_file=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/bindings.lua
marker_begin="-- >>> $plugin_id >>>"
marker_end="-- <<< $plugin_id <<<"

fail() {
  printf 'setup: %s\n' "$1" >&2
  exit 1
}

[ "$(id -u)" -ne 0 ] || fail "run this as your normal user, not with sudo; it asks for sudo itself"
[ -e "$parameter" ] || fail "this kernel does not expose hid_apple fnmode (no Apple keyboard driver loaded)"
user_name=$(id -un)
[[ $user_name =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "unexpected user name '$user_name'"

# Capture both privileged inputs into memory now, before any prompt.
root_script=$(<"$plugin_dir/scripts/setup-root")
helper_bytes=$(<"$plugin_dir/scripts/omarchy-mac-fnmode")
[ -n "$root_script" ] || fail "scripts/setup-root is empty"
[ -n "$helper_bytes" ] || fail "scripts/omarchy-mac-fnmode is empty"

printf 'Installing the root helper and sudo rule for %s (asks for your password).\n' "$user_name"
# $(<file) strips the trailing newline; restore it so the hash matches the pin.
printf '%s\n' "$helper_bytes" |
  /usr/bin/sudo /usr/bin/bash -c "$root_script" setup-root "$user_name"

if [ -f "$bindings_file" ] && grep -qF "$marker_begin" "$bindings_file"; then
  printf 'Hyprland bindings already installed in %s.\n' "$bindings_file"
else
  mkdir -p "$(dirname -- "$bindings_file")"
  cat >>"$bindings_file" <<EOF

$marker_begin
-- Mac Keyboard plugin: function-row bindings and the Mac layout switch.
-- Managed by the plugin's setup/uninstall scripts; edit the plugin copy instead.
local mac_keyboard = os.getenv("HOME") .. "/.config/omarchy/plugins/$plugin_id/hypr/bindings.lua"
local mac_keyboard_file = io.open(mac_keyboard)
if mac_keyboard_file then
  mac_keyboard_file:close()
  dofile(mac_keyboard)
end
$marker_end
EOF
  printf 'Added Hyprland bindings to %s.\n' "$bindings_file"
fi

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -x /usr/bin/hyprctl ]; then
  /usr/bin/hyprctl reload >/dev/null || true
fi

printf '\nSetup complete. The function row now sends brightness, volume and media without Fn.\n'
printf 'Click the Fn keys icon in the bar to switch between that and F1-F12.\n'
